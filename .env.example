# Backend Environment Variables
BACKEND_PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/loan-manager
MONGODB_DB_NAME=loan-manager

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=7d

# Frontend
VITE_API_URL=http://localhost:3000/api

# Firebase Authentication (Optional)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Payment Gateway Integration (Future)
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_MERCHANT_ID=your-merchant-id
PAYMENT_API_KEY=your-api-key

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL_FROM=noreply@loanmanager.com

# Frontend
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_ENV=development

# Payment Recovery Config
RECOVERY_RETRY_DAYS=7
RECOVERY_MAX_ATTEMPTS=3
